<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <RootNamespace>Typizer.Extensions.DependencyInjection</RootNamespace>
    <AssemblyName>Typizer.Extensions.DependencyInjection</AssemblyName>
    <Version>$(TypizerVersion)</Version>

    <PackageId>Typizer.Extensions.DependencyInjection</PackageId>
    <Title>Typizer SDK: ASP.NET Core и Microsoft.Extensions.DependencyInjection</Title>
    <Description>services.AddTypizer(…) для ASP.NET Core и Generic Host: TypizerClient через IHttpClientFactory, настройки через IOptions, журнал SDK — в ILogger.</Description>
    <PackageTags>typizer;sdk;aspnetcore;dependency-injection;httpclientfactory</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Typizer\Typizer.csproj" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
